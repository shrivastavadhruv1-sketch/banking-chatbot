# Banking Chatbot Environment Configuration Template
# Copy this to .env and update with your values

# ====================
# Server Configuration
# ====================
DEBUG=False
FLASK_ENV=production
HOST=0.0.0.0
PORT=5000
SECRET_KEY=your-secure-random-key-here-change-in-production

# ====================
# Database Configuration
# ====================
DATABASE_PATH=database/banking.db

# ====================
# Security Configuration
# ====================
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
LOGIN_ATTEMPT_TIMEOUT=900  # 15 minutes in seconds
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=86400  # 24 hours in seconds

# ====================
# Chatbot Configuration
# ====================
MAX_CONVERSATION_HISTORY=100
RESPONSE_TIMEOUT=30
CONFIDENCE_THRESHOLD=0.7

# ====================
# Offer Configuration
# ====================
MIN_BALANCE_FOR_PREMIUM_OFFERS=100000
OFFER_REFRESH_INTERVAL=7  # days
MAX_PERSONALIZED_OFFERS=5

# ====================
# Transaction Configuration
# ====================
TRANSACTION_ALERT_THRESHOLD=50000
DAILY_TRANSACTION_LIMIT=500000
SUSPICIOUS_TRANSACTION_THRESHOLD=100000

# ====================
# Fraud Detection Configuration
# ====================
FRAUD_ALERT_ENABLED=True
MULTIPLE_LOGIN_ALERT=3
GEOGRAPHIC_ANOMALY_DETECTION=True

# ====================
# Logging Configuration
# ====================
LOG_LEVEL=INFO
LOG_FILE=logs/chatbot.log

# ====================
# NLU Configuration
# ====================
NLU_MODEL=en_core_web_sm
CONFIDENCE_THRESHOLD=0.7

# ====================
# Optional: Email Configuration (for alerts)
# ====================
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# ====================
# Optional: AWS Configuration (for backups)
# ====================
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_BUCKET=your-backup-bucket
# AWS_REGION=us-east-1

# ====================
# Optional: Monitoring Configuration
# ====================
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# DATADOG_API_KEY=your-datadog-api-key
